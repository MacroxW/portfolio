---
import LinkInline from "./ui/LinkInline.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
  summary: string
  highlights: string[]
  technologies: string[]
  eyebrow?: string
}

const { title, company, description, link, date, summary, highlights, technologies, eyebrow } = Astro.props
---

<div
  class="relative ml-7 pb-14 grid before:absolute before:left-[-25px] before:block before:h-full before:border-l before:border-black/15 dark:before:border-white/15 before:content-[''] md:ml-10 md:grid-cols-5 md:gap-10"
>
  <div class="relative pb-6 md:col-span-2">
    <div class="sticky top-24">
      <span class="absolute -left-[31px] top-1 size-3 rounded-full border-2 border-amber-500 bg-gray-50 dark:bg-gray-950"></span>
      {eyebrow && <p class="mb-1 text-xs font-semibold tracking-widest uppercase text-amber-600 dark:text-amber-400">{eyebrow}</p>}
      <h3 class="text-xl font-bold text-gray-900 dark:text-white">{company}</h3>
      <h4 class="mt-1 font-semibold text-gray-600 dark:text-gray-300">{title}</h4>
      <time class="block mt-2 text-sm text-gray-500 dark:text-gray-400">{date}</time>
    </div>
  </div>
  <div class="relative pb-4 text-gray-600 dark:text-gray-300 md:col-span-3">
    <p class="text-lg font-medium leading-7 text-gray-800 dark:text-gray-200">{summary}</p>
    <p class="mt-3 leading-7">{description}</p>
    <ul class="grid gap-2 mt-5" role="list">
      {highlights.map((highlight) => <li class="flex gap-3 leading-6"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-amber-500"></span>{highlight}</li>)}
    </ul>
    <ul class="flex flex-wrap gap-2 mt-5" aria-label={`Tecnologías utilizadas en ${company}`}>
      {technologies.map((technology) => <li class="px-2.5 py-1 text-xs font-medium text-gray-700 border border-gray-200 rounded-full bg-white/60 dark:bg-gray-900/60 dark:border-gray-700 dark:text-gray-300">{technology}</li>)}
    </ul>
    {
      link && (
        <LinkInline href={link}>
          Conocer la empresa{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </>
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
