---
import ThemeToggle from "./ThemeToggle.astro"
import config from "@/config"

const base = import.meta.env.BASE_URL.replace(/\/$/, "")

const navItems = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: `${base}/#experiencia`,
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: `${base}/#proyectos`,
  },
  {
    title: "Capacidades",
    label: "capacidades",
    url: `${base}/#capacidades`,
  },
  {
    title: "Contacto",
    label: "contacto",
    url: `${base}/#contacto`,
  },
]
---

<header
  class="fixed top-0 z-50 flex items-center justify-center w-full px-3 mx-auto mt-3"
>
  <nav
    aria-label="Navegación principal"
    class="flex max-w-full px-2 text-xs font-medium border border-white/60 shadow-lg rounded-full text-gray-600 bg-white/80 dark:bg-gray-900/80 dark:border-white/10 dark:text-gray-200 justify-center items-center backdrop-blur-xl sm:px-3 sm:text-sm"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2.5 transition hover:text-amber-600 dark:hover:text-amber-400 sm:px-3"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <ThemeToggle />
    <a class="sr-only" href={`mailto:${config.email}`}>Enviar correo</a>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a")

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-amber-600")
            } else {
              item.classList.remove("text-amber-600")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-lg ring-1 backdrop-blur dark:bg-gray-800/90 bg-white/50 ring-white/10;
    }
  }
</style>
