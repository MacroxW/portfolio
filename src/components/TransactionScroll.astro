---
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<section id="transaccion" class="profile-story" data-profile-story aria-label="Cómo Marcos lleva una idea hasta producción">
  <div class="profile-sticky">
    <div class="profile-grid"></div>
    <div class="profile-aurora"></div>
    <div class="profile-watermark" aria-hidden="true">PRODUCT</div>

    <header class="profile-header">
      <span>HOW I BUILD</span>
      <span class="profile-signature">MARCOS WENDY · SOFTWARE DEVELOPER</span>
    </header>

    <div class="profile-track"><span></span></div>

    <div class="stage-counter" aria-hidden="true"><strong>01</strong><span>/06</span></div>

    <nav class="phase-rail" aria-hidden="true">
      <span data-step="0"><i></i>PRODUCT</span>
      <span data-step="1"><i></i>BACKEND</span>
      <span data-step="2"><i></i>AI</span>
      <span data-step="3"><i></i>WEB3</span>
      <span data-step="4"><i></i>CLOUD</span>
      <span data-step="5"><i></i>PRODUCTION</span>
    </nav>

    <div class="profile-scene">
      <div class="profile-endpoint profile-idea">
        <span class="endpoint-symbol">?</span>
        <small>PROBLEMA</small>
      </div>

      <div class="profile-route"><span></span></div>

      <div class="skill-node n1" data-skill-node="0">
        <span class="node-icons"><img src={`${base}/tech/react.svg`} alt="" /><img src={`${base}/tech/astro.svg`} alt="" /></span>
        <b>PRODUCT</b><small>React · Astro</small>
      </div>
      <div class="skill-node n2" data-skill-node="1">
        <span class="node-icons"><img src={`${base}/tech/python.svg`} alt="" /><img src={`${base}/tech/nodejs.svg`} alt="" /><img src={`${base}/tech/dotnet.svg`} alt="" /></span>
        <b>BACKEND</b><small>Python · Node · .NET</small>
      </div>
      <div class="skill-node n3" data-skill-node="2">
        <span class="node-icons"><img src={`${base}/tech/azure.svg`} alt="" /></span>
        <b>AI</b><small>Azure OpenAI</small>
      </div>
      <div class="skill-node n4" data-skill-node="3">
        <span class="node-icons"><img src={`${base}/tech/solidity.svg`} alt="" /></span>
        <b>WEB3</b><small>Solidity</small>
      </div>
      <div class="skill-node n5" data-skill-node="4">
        <span class="node-icons"><img src={`${base}/tech/docker.svg`} alt="" /><img src={`${base}/tech/github-actions.svg`} alt="" /><img src={`${base}/tech/aws.svg`} alt="" /><img src={`${base}/tech/gcp.svg`} alt="" /></span>
        <b>DEVOPS</b><small>Cloud · CI/CD</small>
      </div>

      <div class="renvance-proof">
        <img src={`${base}/projects/renvance.webp`} alt="Ilustración conceptual de la plataforma Renvance" />
        <span><small>EXPERIENCIA REAL</small><strong>Renvance</strong><em>Smart contracts · Tokenización</em></span>
      </div>

      <div class="profile-core">
        <div class="core-cube">
          <span class="cube-face cube-front">MW</span>
          <span class="cube-face cube-back">AI</span>
          <span class="cube-face cube-right">API</span>
          <span class="cube-face cube-left">WEB3</span>
          <span class="cube-face cube-top">UI</span>
          <span class="cube-face cube-bottom">OPS</span>
        </div>
        <span class="core-ring"></span>
        <span class="core-value">PRODUCT THINKING</span>
      </div>

      <div class="profile-endpoint profile-production">
        <div class="production-stack"><i></i><i></i><i></i></div>
        <small>PRODUCCIÓN</small>
      </div>

      <i class="data-particle p1"></i><i class="data-particle p2"></i><i class="data-particle p3"></i><i class="data-particle p4"></i>
    </div>

    <div class="profile-copy">
      <article class="profile-chapter" data-chapter="0">
        <p>01 / PRODUCTO & EXPERIENCIA</p>
        <h2>Convierto problemas en experiencias claras.</h2>
        <span>React, TypeScript, Astro y React Native para productos web y mobile centrados en personas.</span>
      </article>
      <article class="profile-chapter" data-chapter="1">
        <p>02 / BACKEND & ARQUITECTURA</p>
        <h2>Diseño la estructura que sostiene el producto.</h2>
        <span>APIs, tiempo real y servicios con Python, Flask, FastAPI, Node.js y .NET.</span>
      </article>
      <article class="profile-chapter" data-chapter="2">
        <p>03 / INTELIGENCIA ARTIFICIAL</p>
        <h2>Integro IA donde genera valor real.</h2>
        <span>Agentes, RAG, documentos y búsqueda semántica con Azure OpenAI, AI Search y Cosmos DB.</span>
      </article>
      <article class="profile-chapter" data-chapter="3">
        <p>04 / BLOCKCHAIN & TRAZABILIDAD</p>
        <h2>Construyo confianza directamente en el código.</h2>
        <span>Smart contracts en Solidity, Web3 y tokenización de activos desarrollados en Renvance.</span>
      </article>
      <article class="profile-chapter" data-chapter="4">
        <p>05 / CLOUD & DEVOPS</p>
        <h2>El desarrollo no termina cuando funciona localmente.</h2>
        <span>Azure, Docker, GitHub Actions, CI/CD, despliegue, monitoreo y operación de infraestructura.</span>
      </article>
      <article class="profile-chapter final-chapter" data-chapter="5">
        <p>06 / PRODUCCIÓN & LIDERAZGO</p>
        <h2>Llevo productos completos hasta producción.</h2>
        <span>Arquitectura, análisis de riesgos, calidad y acompañamiento técnico para convertir una idea en software mantenible.</span>
        <div class="profile-impact">
          <strong>2022<small>experiencia profesional desde</small></strong>
          <strong>600+<small>usuarios en una plataforma real</small></strong>
          <strong>END-TO-END<small>producto, arquitectura y cloud</small></strong>
        </div>
      </article>
    </div>

    <div class="career-signal" aria-hidden="true">
      <span>SOFTTEK</span><i></i><span>RENVANCE</span><i></i><span>PRISMA TECH</span><i></i><span>PYM GESTIONES</span>
    </div>

    <footer class="profile-footer">
      <span class="profile-status-dot"></span>
      <span class="profile-status">Definiendo el producto</span>
      <strong class="profile-percent">000%</strong>
    </footer>
  </div>
</section>

<style>
  .profile-story {
    --story-progress: 0;
    --core-x: 10%;
    --core-y: 0px;
    --core-turn: 0deg;
    --core-scale: .78;
    position: relative;
    width: calc(100% + 2rem);
    height: 420vh;
    margin-inline: -1rem;
    color: white;
  }

  .profile-sticky { position: sticky; top: 0; height: 100vh; min-height: 42rem; overflow: hidden; background: radial-gradient(circle at 50% 50%, #10182c 0, #080b15 48%, #04060c 100%); isolation: isolate; }
  .profile-grid { position: absolute; inset: -20% -10%; z-index: -2; background-image: linear-gradient(rgb(34 211 238 / .1) 1px, transparent 1px), linear-gradient(90deg, rgb(34 211 238 / .1) 1px, transparent 1px); background-size: 48px 48px; transform: perspective(600px) rotateX(62deg) translateY(calc(var(--story-progress) * -220px)); mask-image: radial-gradient(ellipse at center, black 12%, transparent 72%); opacity: .8; }
  .profile-aurora { position: absolute; inset: 8% 18%; z-index: -1; border-radius: 50%; background: conic-gradient(from calc(var(--core-turn) * .2), #f59e0b66, #22d3ee55, #8b5cf655, #34d39944, #f59e0b66); filter: blur(110px); opacity: calc(.38 + var(--story-progress) * .35); scale: calc(.8 + var(--story-progress) * .55); }
  .profile-watermark { position: absolute; z-index: -1; top: 22%; left: 50%; translate: -50% -50%; width: 100%; color: rgb(255 255 255 / .025); font-size: clamp(6rem, 16vw, 17rem); font-weight: 900; line-height: .8; letter-spacing: -.08em; text-align: center; white-space: nowrap; transition: opacity .3s; user-select: none; }

  .profile-header, .profile-footer { position: absolute; z-index: 10; left: clamp(1.25rem, 5vw, 5rem); right: clamp(1.25rem, 5vw, 5rem); display: flex; align-items: center; font: 600 .68rem/1 ui-monospace, monospace; letter-spacing: .2em; color: rgb(255 255 255 / .5); }
  .profile-header { top: 2rem; justify-content: space-between; }
  .profile-footer { bottom: 2rem; gap: .75rem; }
  .profile-percent { margin-left: auto; color: white; font-size: 1rem; }
  .profile-status-dot { width: .5rem; height: .5rem; border-radius: 50%; background: #f59e0b; box-shadow: 0 0 16px #f59e0b; transition: background .4s; }
  .profile-story[data-phase="5"] .profile-status-dot { background: #34d399; box-shadow: 0 0 18px #34d399; }
  .profile-track { position: absolute; z-index: 10; inset: 4.6rem 5% auto; height: 1px; background: rgb(255 255 255 / .1); }
  .profile-track span { display: block; width: calc(var(--story-progress) * 100%); height: 100%; background: linear-gradient(90deg, #f59e0b, #22d3ee, #a78bfa, #34d399); box-shadow: 0 0 12px #22d3ee; }

  .stage-counter { position: absolute; z-index: 10; top: 6.1rem; right: 5%; display: flex; align-items: baseline; gap: .2rem; font-family: ui-monospace, monospace; }
  .stage-counter strong { color: white; font-size: 1.45rem; } .stage-counter span { color: rgb(255 255 255 / .3); font-size: .65rem; }
  .phase-rail { position: absolute; z-index: 9; top: 6.45rem; left: 5%; right: 12%; display: flex; justify-content: space-between; }
  .phase-rail span { display: grid; justify-items: center; gap: .45rem; color: rgb(255 255 255 / .2); font: 600 .55rem/1 ui-monospace, monospace; letter-spacing: .12em; transition: color .35s, transform .35s, opacity .35s; }
  .phase-rail i { display: block; width: .42rem; aspect-ratio: 1; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 4px rgb(255 255 255 / .03); }
  .phase-rail span.is-active { color: #fbbf24; transform: translateY(-3px) scale(1.08); }
  .phase-rail span.is-complete { color: #22d3ee; opacity: .75; }

  .profile-scene { position: absolute; inset: 38% 4% 14%; }
  .profile-route { position: absolute; top: 50%; left: 10%; right: 10%; height: 1px; background: rgb(255 255 255 / .12); }
  .profile-route span { display: block; width: calc(var(--story-progress) * 100%); height: 100%; background: linear-gradient(90deg, #f59e0b, #22d3ee, #a78bfa, #34d399); box-shadow: 0 0 16px #22d3ee; }

  .profile-endpoint { position: absolute; top: 50%; display: grid; place-items: center; gap: .9rem; translate: 0 -50%; }
  .profile-endpoint small { color: rgb(255 255 255 / .45); font: 600 .6rem/1 ui-monospace, monospace; letter-spacing: .18em; white-space: nowrap; }
  .profile-idea { left: 5%; } .profile-production { right: 3%; }
  .endpoint-symbol { display: grid; place-items: center; width: 5.4rem; aspect-ratio: 1; border: 1px solid #f59e0b99; border-radius: 50%; color: #fbbf24; background: #f59e0b18; font: 700 1.6rem/1 ui-monospace, monospace; box-shadow: 0 0 48px #f59e0b38; }
  .production-stack { position: relative; width: 6rem; height: 6rem; }
  .production-stack i { position: absolute; inset: .8rem; border: 1px solid #22d3ee88; background: #22d3ee0d; rotate: 45deg; transition: 600ms cubic-bezier(.16, 1, .3, 1); box-shadow: 0 0 24px #22d3ee14; }
  .production-stack i:nth-child(2) { translate: -.75rem -.75rem; opacity: .5; } .production-stack i:nth-child(3) { translate: -1.5rem -1.5rem; opacity: .2; }
  .profile-story[data-phase="5"] .production-stack i { background: #34d3992b; border-color: #34d399; box-shadow: 0 0 30px #34d39977; }

  .skill-node { position: absolute; z-index: 2; display: grid; place-items: center; gap: .35rem; width: 6.6rem; aspect-ratio: 1; border: 1px solid rgb(255 255 255 / .12); border-radius: 1.5rem; color: rgb(255 255 255 / .24); background: #0f172adb; box-shadow: 0 18px 55px rgb(0 0 0 / .22); backdrop-filter: blur(14px); transition: 500ms cubic-bezier(.16, 1, .3, 1); }
  .skill-node b { font: 700 .68rem/1 ui-monospace, monospace; } .skill-node small { font: 500 .47rem/1 ui-monospace, monospace; }
  .node-icons { display: flex; align-items: center; justify-content: center; gap: .28rem; min-height: 1.25rem; }
  .node-icons img { width: 1.35rem; height: 1.35rem; object-fit: contain; opacity: .24; filter: grayscale(1); transition: opacity .4s, filter .4s, scale .4s; }
  .skill-node.is-complete { color: rgb(255 255 255 / .68); border-color: #22d3ee55; background: #0891b212; scale: .9; }
  .skill-node.is-current { z-index: 6; color: #fff; border-color: #22d3ee; background: linear-gradient(145deg, #0891b23d, #0f172aee); box-shadow: 0 0 0 1px #22d3ee22, 0 0 45px #22d3ee55, 0 22px 60px rgb(0 0 0 / .38); scale: 1.2; translate: 0 -8px; }
  .skill-node.is-current .node-icons img, .skill-node.is-complete .node-icons img { opacity: 1; filter: none; scale: 1.08; }
  .n1 { left: 18%; top: 20%; } .n2 { left: 33%; bottom: 4%; } .n3 { left: 47%; top: 3%; } .n4 { left: 62%; bottom: 3%; } .n5 { left: 76%; top: 18%; }

  .renvance-proof { position: absolute; z-index: 7; top: -8%; right: 8%; display: grid; grid-template-columns: 5.2rem 1fr; align-items: center; width: 16.5rem; padding: .55rem; border: 1px solid rgb(167 139 250 / .5); border-radius: 1rem; color: white; background: rgb(15 23 42 / .9); box-shadow: 0 18px 55px rgb(0 0 0 / .38); backdrop-filter: blur(14px); opacity: 0; translate: 1.5rem 1rem; scale: .84; transition: 550ms cubic-bezier(.16, 1, .3, 1); pointer-events: none; }
  .renvance-proof img { width: 5.2rem; height: 3.7rem; border-radius: .7rem; object-fit: cover; }
  .renvance-proof span { display: grid; gap: .15rem; padding-left: .55rem; } .renvance-proof small { color: #a78bfa; font: 700 .42rem/1 ui-monospace, monospace; letter-spacing: .12em; }
  .renvance-proof strong { font-size: .8rem; } .renvance-proof em { color: rgb(255 255 255 / .45); font-size: .5rem; font-style: normal; }
  .profile-story[data-phase="3"] .renvance-proof { opacity: 1; translate: 0 0; scale: 1; }

  .profile-core { position: absolute; z-index: 8; left: var(--core-x); top: 50%; width: 6.5rem; height: 6.5rem; transform: translate(-50%, var(--core-y)) scale(var(--core-scale)); transform-style: preserve-3d; filter: drop-shadow(0 18px 28px rgb(0 0 0 / .45)); }
  .core-cube { position: absolute; inset: 1rem; transform-style: preserve-3d; animation: core-idle 7s linear infinite; }
  .cube-face { position: absolute; inset: 0; display: grid; place-items: center; border: 1px solid #fbbf24dd; background: #0f172af2; color: #fef3c7; font: 700 .8rem/1 ui-monospace, monospace; box-shadow: inset 0 0 22px #f59e0b30; backface-visibility: hidden; transition: border-color .4s, color .4s; }
  .profile-story[data-phase="2"] .cube-face { border-color: #22d3ee; color: #a5f3fc; }
  .profile-story[data-phase="3"] .cube-face { border-color: #a78bfa; color: #ddd6fe; }
  .profile-story[data-phase="4"] .cube-face, .profile-story[data-phase="5"] .cube-face { border-color: #34d399; color: #a7f3d0; }
  .cube-front { transform: translateZ(2.25rem); } .cube-back { transform: rotateY(180deg) translateZ(2.25rem); }
  .cube-right { transform: rotateY(90deg) translateZ(2.25rem); } .cube-left { transform: rotateY(-90deg) translateZ(2.25rem); }
  .cube-top { transform: rotateX(90deg) translateZ(2.25rem); } .cube-bottom { transform: rotateX(-90deg) translateZ(2.25rem); }
  .core-ring { position: absolute; inset: -.4rem; border: 1px solid #22d3ee88; border-radius: 50%; animation: core-ring 1.8s ease-out infinite; }
  .core-value { position: absolute; top: calc(100% + .85rem); left: 50%; padding: .5rem .8rem; border: 1px solid rgb(255 255 255 / .18); border-radius: 999px; translate: -50%; color: #fbbf24; background: rgb(5 7 17 / .94); box-shadow: 0 10px 30px rgb(0 0 0 / .38); font: 700 .56rem/1 ui-monospace, monospace; letter-spacing: .12em; white-space: nowrap; transition: color .4s, border-color .4s; }
  .profile-story[data-phase="2"] .core-value { color: #67e8f9; border-color: #22d3ee66; }
  .profile-story[data-phase="3"] .core-value { color: #c4b5fd; border-color: #a78bfa66; }
  .profile-story[data-phase="4"] .core-value, .profile-story[data-phase="5"] .core-value { color: #6ee7b7; border-color: #34d39966; }

  .data-particle { position: absolute; top: 50%; left: var(--core-x); width: .28rem; aspect-ratio: 1; border-radius: 50%; background: #22d3ee; box-shadow: 0 0 12px #22d3ee; transform: translate(calc(-2rem - var(--particle-gap)), calc(var(--core-y) + var(--particle-y))); opacity: calc(.2 + var(--story-progress)); }
  .p1 { --particle-gap: 1rem; --particle-y: 1rem; } .p2 { --particle-gap: 2.5rem; --particle-y: -1.4rem; } .p3 { --particle-gap: 4rem; --particle-y: .2rem; } .p4 { --particle-gap: 5.5rem; --particle-y: -2.2rem; }

  .profile-copy { position: absolute; z-index: 8; top: 13%; left: 50%; width: min(92%, 66rem); min-height: 13rem; translate: -50% 0; text-align: center; }
  .profile-chapter { position: absolute; inset: 0; opacity: 0; translate: 0 2rem; filter: blur(12px); transition: 480ms cubic-bezier(.16, 1, .3, 1); pointer-events: none; }
  .profile-chapter.is-active { opacity: 1; translate: 0 0; filter: blur(0); pointer-events: auto; }
  .profile-chapter p { margin-bottom: .65rem; color: #fbbf24; font: 700 .7rem/1 ui-monospace, monospace; letter-spacing: .22em; }
  .profile-chapter h2 { font-size: clamp(2rem, 4.2vw, 4.4rem); line-height: .98; letter-spacing: -.05em; text-wrap: balance; }
  .profile-chapter > span { display: block; max-width: 50rem; margin: 1rem auto 0; color: rgb(255 255 255 / .62); font-size: clamp(.9rem, 1.25vw, 1.08rem); line-height: 1.55; }
  .profile-impact { display: flex; justify-content: center; gap: clamp(1rem, 4vw, 3.5rem); margin-top: 1.2rem; }
  .profile-impact strong { font-size: 1rem; color: #a7f3d0; } .profile-impact small { display: block; margin-top: .25rem; color: rgb(255 255 255 / .42); font-size: .58rem; font-weight: 500; }

  .career-signal { position: absolute; z-index: 5; left: 50%; bottom: 4.9rem; display: flex; align-items: center; gap: 1rem; translate: -50%; color: rgb(255 255 255 / .24); font: 600 .5rem/1 ui-monospace, monospace; letter-spacing: .14em; white-space: nowrap; }
  .career-signal i { width: 1.5rem; height: 1px; background: currentColor; }

  @keyframes core-idle { to { transform: rotateX(360deg) rotateY(360deg); } }
  @keyframes core-ring { from { scale: .7; opacity: .9; } to { scale: 1.7; opacity: 0; } }

  @media (max-width: 640px) {
    .profile-story { height: 380vh; }
    .profile-sticky { min-height: 38rem; }
    .profile-signature, .profile-endpoint small, .career-signal { display: none; }
    .phase-rail span { font-size: 0; } .phase-rail i { width: .5rem; }
    .stage-counter { top: 5.8rem; }
    .profile-copy { top: 13%; min-height: 15rem; }
    .profile-chapter h2 { font-size: clamp(1.6rem, 8vw, 2.3rem); }
    .profile-scene { inset-inline: 0; top: 42%; bottom: 18%; }
    .profile-idea { left: 1%; } .profile-production { right: -1%; }
    .endpoint-symbol { width: 3.2rem; } .production-stack { width: 3.7rem; height: 3.7rem; }
    .profile-core { width: 5rem; height: 5rem; }
    .core-cube { inset: .8rem; }
    .cube-front { transform: translateZ(1.7rem); } .cube-back { transform: rotateY(180deg) translateZ(1.7rem); }
    .cube-right { transform: rotateY(90deg) translateZ(1.7rem); } .cube-left { transform: rotateY(-90deg) translateZ(1.7rem); }
    .cube-top { transform: rotateX(90deg) translateZ(1.7rem); } .cube-bottom { transform: rotateX(-90deg) translateZ(1.7rem); }
    .skill-node { width: 3.25rem; border-radius: 1rem; } .skill-node small, .skill-node b { display: none; }
    .node-icons { gap: .15rem; } .node-icons img { width: .78rem; height: .78rem; }
    .n1 { left: 17%; } .n2 { left: 31%; } .n3 { left: 45%; } .n4 { left: 60%; } .n5 { left: 74%; }
    .renvance-proof { display: none; }
    .profile-chapter > span { padding-inline: .8rem; font-size: .82rem; line-height: 1.4; }
    .profile-impact { gap: .75rem; } .profile-impact strong { font-size: .78rem; } .profile-impact small { font-size: .48rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-story { height: 100vh; } .core-cube, .core-ring { animation: none; } .profile-chapter { transition: none; }
  }
</style>

<script>
  const setupProfileStory = () => {
    const storyWindow = window as Window & { __profileStoryBound?: boolean }
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    const stories = document.querySelectorAll<HTMLElement>("[data-profile-story]")
    const statuses = [
      "Diseñando la experiencia",
      "Construyendo la arquitectura",
      "Integrando inteligencia artificial",
      "Añadiendo trazabilidad Web3",
      "Desplegando en cloud",
      "Producto en producción",
    ]
    const values = [
      "PRODUCT THINKING",
      "END-TO-END SYSTEM",
      "AI SOLUTIONS",
      "TRUST BY CODE",
      "CLOUD READY",
      "PRODUCTION VALUE",
    ]
    const stageNames = ["PRODUCT", "ARCHITECTURE", "AI", "WEB3", "DEVOPS", "PRODUCTION"]

    const update = () => {
      stories.forEach((story) => {
        const rect = story.getBoundingClientRect()
        const distance = Math.max(1, rect.height - window.innerHeight)
        const progress = reducedMotion ? 1 : Math.min(1, Math.max(0, -rect.top / distance))
        const phase = Math.min(5, Math.floor(progress * 6))
        const localPhase = (progress * 6) % 1
        const arc = Math.sin(localPhase * Math.PI) * -Math.min(75, window.innerWidth * .09)
        const scale = .76 + Math.sin(localPhase * Math.PI) * .35 + phase * .025

        story.dataset.phase = String(phase)
        story.style.setProperty("--story-progress", progress.toFixed(4))
        story.style.setProperty("--core-x", `${10 + progress * 80}%`)
        story.style.setProperty("--core-y", `${arc}px`)
        story.style.setProperty("--core-turn", `${progress * 1080}deg`)
        story.style.setProperty("--core-scale", scale.toFixed(3))

        story.querySelectorAll<HTMLElement>("[data-chapter]").forEach((chapter) => chapter.classList.toggle("is-active", Number(chapter.dataset.chapter) === phase))
        story.querySelectorAll<HTMLElement>("[data-skill-node]").forEach((node) => {
          const index = Number(node.dataset.skillNode)
          node.classList.toggle("is-current", index === phase)
          node.classList.toggle("is-complete", index < phase)
        })
        story.querySelectorAll<HTMLElement>("[data-step]").forEach((step) => {
          const index = Number(step.dataset.step)
          step.classList.toggle("is-active", index === phase)
          step.classList.toggle("is-complete", index < phase)
        })

        const percent = story.querySelector<HTMLElement>(".profile-percent")
        const status = story.querySelector<HTMLElement>(".profile-status")
        const value = story.querySelector<HTMLElement>(".core-value")
        const watermark = story.querySelector<HTMLElement>(".profile-watermark")
        const stageCounter = story.querySelector<HTMLElement>(".stage-counter strong")
        if (percent) percent.textContent = `${String(Math.round(progress * 100)).padStart(3, "0")}%`
        if (status) status.textContent = statuses[phase]
        if (value) value.textContent = values[phase]
        if (watermark) watermark.textContent = stageNames[phase]
        if (stageCounter) stageCounter.textContent = String(phase + 1).padStart(2, "0")
      })
    }

    if (!storyWindow.__profileStoryBound) {
      let frame = 0
      const requestUpdate = () => {
        if (frame) return
        frame = requestAnimationFrame(() => { frame = 0; update() })
      }
      window.addEventListener("scroll", requestUpdate, { passive: true })
      window.addEventListener("resize", requestUpdate)
      storyWindow.__profileStoryBound = true
    }

    update()
  }

  setupProfileStory()
  document.addEventListener("astro:page-load", setupProfileStory)
</script>
