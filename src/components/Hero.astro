---
const personalImageAlt = "Marcos Wendy";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import GitHubIcon from "@/components/icons/GitHub.astro";
import SocialPill from "@/components/ui/SocialPill.astro";
import config from "@/config";

const { email, linkedin, github, location } = config;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="max-w-4xl">
  <div>
    <div class="flex flex-wrap items-center gap-4 mb-6">
        <img
            class="rounded-full shadow-lg ring-4 ring-white dark:ring-gray-800 size-16"
            src={`${base}/profile.png`}
            alt={personalImageAlt}
            width="64"
            height="64"
        />
        <span class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium text-emerald-800 bg-emerald-100 border border-emerald-200 rounded-full dark:text-emerald-200 dark:bg-emerald-950 dark:border-emerald-800">
          <span class="size-2 bg-emerald-500 rounded-full animate-pulse"></span>
          Disponible para nuevas oportunidades
        </span>
    </div>
    <p class="mb-3 text-sm font-semibold tracking-[0.18em] uppercase text-amber-600 dark:text-amber-400">
      {location}
    </p>
    <h1
        class="text-5xl font-bold tracking-tight text-gray-900 sm:text-6xl dark:text-white"
    >
        Marcos Wendy
    </h1>
    <p class="mt-4 text-2xl font-semibold text-gray-700 dark:text-gray-200">
      Full Stack Developer <span class="text-amber-600 dark:text-amber-400">· AI Solutions · Software Architecture</span>
    </p>
    <p class="max-w-2xl mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
      Desarrollador Full Stack especializado en construir productos digitales completos, desde arquitectura y backend hasta frontend, infraestructura e integración de inteligencia artificial. Actualmente trabajo en Softtek desarrollando soluciones basadas en IA y, paralelamente, construyo Wubboo, una plataforma profesional multiplataforma.
    </p>
    <nav aria-label="Acciones principales" class="flex flex-wrap gap-3 mt-8">
        <a class="inline-flex items-center px-5 py-2.5 font-semibold text-white transition bg-gray-900 rounded-full hover:-translate-y-0.5 hover:bg-amber-600 dark:bg-white dark:text-gray-900 dark:hover:bg-amber-300" href={`${base}/#experiencia`}>
          Ver experiencia
        </a>
        <SocialPill href={`${base}/#proyectos`}>
          Ver proyectos
        </SocialPill>
        <SocialPill href=`mailto:${email}`>
            <MailIcon class="size-4" />
            Contactarme
        </SocialPill>
        <SocialPill href={linkedin}>
            <LinkedInIcon class="size-4" />
            LinkedIn
        </SocialPill>
        <SocialPill href={github}>
            <GitHubIcon class="size-4" />
            GitHub
        </SocialPill>
    </nav>
  </div>
</div>
