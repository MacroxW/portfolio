---
const personalImageAlt = "Marcos Wendy";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import GitHubIcon from "@/components/icons/GitHub.astro";
import SocialPill from "@/components/ui/SocialPill.astro";
import BlockchainOrbit from "@/components/BlockchainOrbit.astro";
import config from "@/config";

const { email, linkedin, github, location } = config;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="grid items-center gap-12 lg:grid-cols-[1fr_18rem]">
  <div class="max-w-3xl">
    <div class="hero-enter flex flex-wrap items-center gap-4 mb-6" style="--enter-delay: 80ms">
        <img
            class="rounded-full shadow-lg ring-4 ring-white dark:ring-gray-800 size-16"
            src={`${base}/profile.png`}
            alt={personalImageAlt}
            width="64"
            height="64"
        />
        <span class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium text-emerald-800 bg-emerald-100 border border-emerald-200 rounded-full dark:text-emerald-200 dark:bg-emerald-950 dark:border-emerald-800">
          <span class="size-2 bg-emerald-500 rounded-full animate-pulse"></span>
          Disponible para nuevas oportunidades
        </span>
    </div>
    <p class="hero-enter mb-3 text-sm font-semibold tracking-[0.18em] uppercase text-amber-600 dark:text-amber-400" style="--enter-delay: 170ms">
      {location}
    </p>
    <h1
        class="hero-enter text-5xl font-bold tracking-tight text-gray-900 sm:text-6xl dark:text-white"
        style="--enter-delay: 250ms"
    >
        Marcos Wendy
    </h1>
    <p class="hero-enter mt-4 text-2xl font-semibold text-gray-700 dark:text-gray-200" style="--enter-delay: 340ms">
      Software Developer <span class="text-amber-600 dark:text-amber-400">| Full Stack & AI Solutions</span>
    </p>
    <p class="hero-enter max-w-2xl mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300" style="--enter-delay: 430ms">
      Desarrollo productos digitales escalables: desde la arquitectura y la experiencia de usuario hasta las APIs, integraciones con inteligencia artificial, infraestructura y despliegue en cloud.
    </p>
    <p class="hero-enter max-w-2xl mt-3 text-base leading-7 text-gray-500 dark:text-gray-400" style="--enter-delay: 510ms">
      Experiencia profesional desde 2022 trabajando con React, TypeScript, Python, Node.js, .NET, Azure y arquitecturas orientadas a productos.
    </p>
    <nav aria-label="Acciones principales" class="hero-enter flex flex-wrap gap-3 mt-8" style="--enter-delay: 600ms">
        <a class="inline-flex items-center px-5 py-2.5 font-semibold text-white transition bg-gray-900 rounded-full hover:-translate-y-0.5 hover:bg-amber-600 dark:bg-white dark:text-gray-900 dark:hover:bg-amber-300" href={`${base}/#proyectos`}>
          Ver proyectos
        </a>
        <SocialPill href={`mailto:${email}?subject=Solicitud%20de%20CV`}>
            <MailIcon class="size-4" />
            Solicitar CV
        </SocialPill>
        <SocialPill href=`mailto:${email}`>
            <MailIcon class="size-4" />
            Contactarme
        </SocialPill>
        <SocialPill href={linkedin}>
            <LinkedInIcon class="size-4" />
            LinkedIn
        </SocialPill>
        <SocialPill href={github}>
            <GitHubIcon class="size-4" />
            GitHub
        </SocialPill>
    </nav>
  </div>
  <div class="hero-visual-enter relative hidden lg:block">
    <BlockchainOrbit />
  </div>
</div>

<style>
  .hero-enter {
    animation: hero-enter 850ms cubic-bezier(.16, 1, .3, 1) var(--enter-delay, 0ms) both;
  }

  .hero-visual-enter {
    animation: hero-visual-enter 1100ms cubic-bezier(.16, 1, .3, 1) 320ms both;
  }

  @keyframes hero-enter {
    from { opacity: 0; translate: 0 2rem; filter: blur(12px); }
    to { opacity: 1; translate: 0 0; filter: blur(0); }
  }

  @keyframes hero-visual-enter {
    from { opacity: 0; scale: .68; rotate: -8deg; filter: blur(18px); }
    to { opacity: 1; scale: 1; rotate: 0deg; filter: blur(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter, .hero-visual-enter { animation: none; }
  }
</style>
