---
import GitHubIcon from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";

const PROJECTS = [
  {
    title: "Promptia",
    kicker: "IA · Aplicación full stack",
    description: "Chat con Google Gemini, agentes personalizables, herramientas, autenticación JWT, conversaciones persistentes y respuestas por streaming.",
    detail: "Monorepo con aplicación React y API Express, contratos compartidos, MongoDB y validación con Zod.",
    tags: ["React", "TypeScript", "Express", "MongoDB", "Gemini", "SSE"],
    link: "https://github.com/MacroxW/promptia",
  },
  {
    title: "ISO 3166 Argentina",
    kicker: "Open source · Datos y backend",
    description: "Sistema jerárquico de países, provincias, departamentos y localidades argentinas basado en ISO 3166 y fuentes oficiales de INDEC.",
    detail: "Incluye entidades TypeORM, coordenadas, soporte para AMBA, exportaciones JSON y 23 tests de integración documentados.",
    tags: ["TypeScript", "TypeORM", "SQLite", "Vitest", "Open Data"],
    link: "https://github.com/MacroxW/iso3166-countries-argentina",
  },
  {
    title: "Console Warrior",
    kicker: "Developer tooling · VS Code",
    description: "Extensión open source para visualizar logs de ejecución directamente junto al código y reducir el cambio de contexto durante el desarrollo.",
    detail: "Proyecto en desarrollo con decoraciones del editor, captura de logs y gestión de servidores Vite.",
    tags: ["TypeScript", "VS Code API", "Developer Experience", "Vite"],
    link: "https://github.com/MacroxW/console-warrior",
  },
  {
    title: "PyM Gestiones",
    kicker: "Producto independiente · SaaS",
    description: "Plataforma administrativa creada a medida con módulos de gestión, roles, permisos y estados de negocio.",
    detail: "Desarrollo full stack, relevamiento con el cliente, despliegue y soporte productivo para un producto utilizado por más de 600 usuarios.",
    tags: ["React", "TypeScript", "Redux", ".NET", "C#", "SQL", "Docker"],
    link: "https://pymgestiones.com.ar",
    external: true,
  },
];
---

<div class="grid gap-4 md:grid-cols-2">
  {PROJECTS.map(({ title, kicker, description, detail, tags, link, external }) => (
    <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900 md:p-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-amber-600 dark:text-amber-400">{kicker}</p>
      <h3 class="mt-3 text-2xl font-bold text-gray-900 dark:text-white">{title}</h3>
      <p class="mt-3 leading-6 text-gray-600 dark:text-gray-300">{description}</p>
      <p class="mt-2 text-sm leading-5 text-gray-500 dark:text-gray-400">{detail}</p>
      <ul class="flex flex-wrap gap-1.5 mt-4" aria-label={`Tecnologías de ${title}`}>
        {tags.map((tag) => <li class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">{tag}</li>)}
      </ul>
      <footer class="mt-auto pt-5">
        <a href={link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-semibold text-gray-900 underline-offset-4 hover:text-amber-600 hover:underline dark:text-white dark:hover:text-amber-400">
          {external ? <Link class="size-4" /> : <GitHubIcon class="size-4" />}
          {external ? "Visitar producto" : "Ver repositorio"}
        </a>
      </footer>
    </article>
  ))}
</div>
